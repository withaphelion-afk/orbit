# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API server for the web terminal (uv run python -m orbit.api)
ORBIT_API_HOST=127.0.0.1
ORBIT_API_PORT=8000

# Shared data on a GitHub "data" branch (src/orbit/datasync.py)
ORBIT_DATA_SYNC=1            # 0 turns the sync off on this machine
ORBIT_DATA_SYNC_REMOTE=origin  # "data" once you've run: git remote add data https://github.com/withaphelion-afk/orbit-data.git
ORBIT_DATA_SYNC_JOURNAL=0    # 1 shares your journal too; only with a private data repo
