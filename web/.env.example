# Copy to web/.env.local if you need to change where the API lives.
# The dev server proxies /api and /ws to this address (see vite.config.ts).
ORBIT_API_TARGET=http://127.0.0.1:8000
# For a production build served from a different origin than the API:
# VITE_ORBIT_API_BASE=https://orbit-api.example.com
